# Backend Environment Variables Example
# Copy this file to .env and update the values

# JWT Secret Key (for token generation and verification)
JWT_SECRET_KEY=generate-a-secure-random-string-here

# Google OAuth credentials (get these from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Database connection
DATABASE_URI=sqlite:///noir_et_or.db

# For production, use a more robust database like PostgreSQL:
# DATABASE_URI=postgresql://username:password@localhost:5432/noir_et_or